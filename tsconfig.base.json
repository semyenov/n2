{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@semyenov/n2": ["./packages/n2/index.ts"],
      "@semyenov/n2/helpers": ["./packages/n2/src/framework/helpers/index.ts"],
      "@semyenov/n2/domain": ["./packages/n2/src/framework/domain/index.ts"],
      "@semyenov/n2/testing": ["./packages/n2/src/framework/testing/index.ts"],
      "@semyenov/n2/adapters/http": ["./packages/n2/src/adapters/http/index.ts"],
      "@semyenov/n2/adapters/http/index": ["./packages/n2/src/adapters/http/index.ts"],
      "@semyenov/n2/adapters/http/index.js": ["./packages/n2/src/adapters/http/index.ts"],
      "@semyenov/n2/adapters/http/*.js": ["./packages/n2/src/adapters/http/*.ts"],
      "@semyenov/n2/framework/helpers": ["./packages/n2/src/framework/helpers/index.ts"],
      "@semyenov/n2/framework/helpers/index": ["./packages/n2/src/framework/helpers/index.ts"],
      "@semyenov/n2/framework/helpers/index.js": ["./packages/n2/src/framework/helpers/index.ts"],
      "@semyenov/n2/framework/helpers/*.js": ["./packages/n2/src/framework/helpers/*.ts"],
      "@semyenov/n2/framework/domain": ["./packages/n2/src/framework/domain/index.ts"],
      "@semyenov/n2/framework/domain/index": ["./packages/n2/src/framework/domain/index.ts"],
      "@semyenov/n2/framework/domain/index.js": ["./packages/n2/src/framework/domain/index.ts"],
      "@semyenov/n2/framework/domain/*.js": ["./packages/n2/src/framework/domain/*.ts"],
      "@semyenov/n2/framework/testing": ["./packages/n2/src/framework/testing/index.ts"],
      "@semyenov/n2/framework/testing/index": ["./packages/n2/src/framework/testing/index.ts"],
      "@semyenov/n2/framework/testing/index.js": ["./packages/n2/src/framework/testing/index.ts"],
      "@semyenov/n2/framework/testing/*.js": ["./packages/n2/src/framework/testing/*.ts"],
      "@semyenov/n2/src/main": ["./packages/n2/src/main.ts"],
      "@semyenov/n2/src/main.js": ["./packages/n2/src/main.ts"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
